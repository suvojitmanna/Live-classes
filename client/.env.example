# ==============================================
# Live Classes Frontend Environment Variables
# ==============================================

# Backend API Base URL
VITE_BASE_URL=http://localhost:5000/api

# Backend Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth Client ID (Frontend Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WebRTC STUN Server URL (Default Google STUN)
VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302

# WebRTC TURN Server Configuration (For restrictive NAT / Firewall traversing)
# For production: e.g., Coturn or Metered/Twilio TURN credentials
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
